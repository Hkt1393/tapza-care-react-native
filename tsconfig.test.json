{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "target": "ES2022",
    "jsx": "react-jsx",
    "rootDir": ".",
    "outDir": ".test-build",
    "types": [],
    "customConditions": null,
    "ignoreDeprecations": "6.0",
    "noEmit": false,
    "declaration": false
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
